{
  "manifest_version": 3,
  "name": "清译 · 网页双语翻译",
  "version": "1.0.4",
  "description": "自动识别外语并翻译成简体中文，段落双语对照、选中文字翻译、一键恢复。免费，无需密钥。",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/translate/*",
    "https://transmart.qq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dates.js", "languages.js", "content.js", "video.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": { "default_popup": "popup.html", "default_title": "清译" },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译当前外语网页"
    }
  }
}
