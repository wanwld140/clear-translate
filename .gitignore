# 只提交明确的工程文件；本地 QA、浏览器资料和探测脚本留在工作区。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/package-extension.py
!/core.test.mjs
!/安装与使用.txt
!/extension/
!/extension/**
!/scripts/
!/scripts/**
!/tests/
!/tests/**
!/.github/
!/.github/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials.json
**/node_modules/
**/__pycache__/
**/*.pyc
